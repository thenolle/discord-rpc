{
  "name": "discord-rpc",
  "version": "1.0.0",
  "description": "Ultra-light Discord Rich Presence",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:win": "pkg . --target node20-win-x64 --output dist/drpc.exe --compress GZip",
    "build:mac": "pkg . --target node20-mac-x64 --output dist/drpc-mac --compress GZip",
    "build:linux": "pkg . --target node20-linux-x64 --output dist/drpc-linux --compress GZip",
    "build:all": "npm run build:win && npm run build:mac && npm run build:linux"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0"
  }
}