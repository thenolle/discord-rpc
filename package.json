{
  "name": "discord-rpc",
  "version": "1.0.0",
  "description": "Ultra-light Discord Rich Presence",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:win": "pkg . --target node20-win-x64 --output dist/drpc.exe --compress GZip && pnpm run build:win:launcher",
    "build:win:launcher": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('scripts/run-hidden.vbs','dist/run-hidden.vbs')\"",
    "build:mac": "pkg . --target node20-mac-x64 --output dist/drpc-mac --compress GZip",
    "build:linux": "pkg . --target node20-linux-x64 --output dist/drpc-linux --compress GZip",
    "build:all": "pnpm run build:win && pnpm run build:mac && pnpm run build:linux"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "scripts/run-hidden.vbs"
    ],
    "targets": [
      "node20-win-x64",
      "node20-mac-x64",
      "node20-linux-x64"
    ]
  },
  "dependencies": {
    "systray2": "^2.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0"
  }
}